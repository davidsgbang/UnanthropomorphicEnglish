{
  "name": "unanthropomorphic-english",
  "displayName": "Unanthropomorphic English",
  "description": "Write clear technical text with ASD-STE100 rules and no human persona.",
  "version": "1.0.0",
  "author": {
    "name": "David Bang"
  },
  "homepage": "https://github.com/davidsgbang/UnanthromorphicEnglish",
  "repository": "https://github.com/davidsgbang/UnanthromorphicEnglish",
  "license": "MIT",
  "keywords": [
    "technical-writing",
    "documentation",
    "ste",
    "asd-ste100"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/unanthropomorphic-english-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading Unanthropomorphic English..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10,
            "statusMessage": "Unanthropomorphic English: checking the file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
